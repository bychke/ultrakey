<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UltraKey – background remover / chroma key effect for Paint.NET 5.1+.

    Paint.NET's assemblies are referenced from an installation (or extracted portable ZIP):
      dotnet build -c Release -p:PdnDir="C:\Program Files\paint.net"
    The output UltraKey.dll goes into "<Documents>\paint.net App Files\Effects" (or "<PdnDir>\Effects").
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>UltraKey</RootNamespace>
    <AssemblyName>UltraKey</AssemblyName>
    <Version>1.4.0</Version>
    <Product>UltraKey</Product>
    <Description>Background remover and chroma key effect for Paint.NET</Description>
    <Copyright>MIT License</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Paint.NET itself references an older System.Runtime.Serialization.Formatters facade; harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PdnDir Condition="'$(PdnDir)' == ''">C:\Program Files\paint.net</PdnDir>
    <!-- Oldest Paint.NET the plugin declares it needs (5.100 = 5.1.0), see tools/PdnRefFix. -->
    <PdnMinimumVersion Condition="'$(PdnMinimumVersion)' == ''">5.100.0.0</PdnMinimumVersion>
    <!-- No pdb: it would no longer match the rewritten DLL. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.png" LogicalName="UltraKey.Icon.png" />
  </ItemGroup>

  <!--
    BiRefNet runs on ONNX Runtime (DirectML on any DirectX 12 GPU, CPU otherwise). Paint.NET only loads the plugin
    DLL itself, so the runtime is embedded (see Core/Ai/OnnxRuntimeLoader.cs) instead of copied next to it.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" GeneratePathProperty="true" ExcludeAssets="runtime;native;build;buildTransitive" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" GeneratePathProperty="true" ExcludeAssets="runtime;build;buildTransitive" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <OrtRuntimeFile Include="$(PkgMicrosoft_ML_OnnxRuntime_Managed)/lib/net8.0/Microsoft.ML.OnnxRuntime.dll" />
    <OrtRuntimeFile Include="$(PkgMicrosoft_ML_OnnxRuntime_DirectML)/runtimes/win-x64/native/onnxruntime.dll" />
    <OrtRuntimeFile Include="$(PkgMicrosoft_AI_DirectML)/bin/x64-win/DirectML.dll" />
  </ItemGroup>

  <UsingTask TaskName="GzipFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDir);
        foreach (var item in Files)
        {
            string target = Path.Combine(OutputDir, Path.GetFileName(item.ItemSpec) + ".gz");
            using var input = File.OpenRead(item.ItemSpec);
            using var output = File.Create(target);
            using var gz = new GZipStream(output, CompressionLevel.Optimal);
            input.CopyTo(gz);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- IntermediateOutputPath is not defined yet while the project body is evaluated, hence obj/ort. -->
  <ItemGroup>
    <OrtPackedFile Include="@(OrtRuntimeFile->'$(BaseIntermediateOutputPath)ort/%(Filename)%(Extension).gz')" />
    <EmbeddedResource Include="@(OrtPackedFile)" LogicalName="UltraKey.ort.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="EmbedOnnxRuntime" BeforeTargets="PrepareResourceNames" Inputs="@(OrtRuntimeFile)" Outputs="@(OrtPackedFile)">
    <GzipFiles Files="@(OrtRuntimeFile)" OutputDir="$(BaseIntermediateOutputPath)ort" />
  </Target>

  <ItemGroup>
    <Reference Include="PaintDotNet.Base"><HintPath>$(PdnDir)\PaintDotNet.Base.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.ComponentModel"><HintPath>$(PdnDir)\PaintDotNet.ComponentModel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Core"><HintPath>$(PdnDir)\PaintDotNet.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Effects.Core"><HintPath>$(PdnDir)\PaintDotNet.Effects.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Framework"><HintPath>$(PdnDir)\PaintDotNet.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Fundamentals"><HintPath>$(PdnDir)\PaintDotNet.Fundamentals.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.ObjectModel"><HintPath>$(PdnDir)\PaintDotNet.ObjectModel.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Primitives"><HintPath>$(PdnDir)\PaintDotNet.Primitives.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.PropertySystem"><HintPath>$(PdnDir)\PaintDotNet.PropertySystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Windows"><HintPath>$(PdnDir)\PaintDotNet.Windows.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Windows.Core"><HintPath>$(PdnDir)\PaintDotNet.Windows.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PaintDotNet.Windows.Framework"><HintPath>$(PdnDir)\PaintDotNet.Windows.Framework.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    Paint.NET refuses plugins that reference a newer PaintDotNet.* version than the installed one. Rewrite the
    references recorded from the build-time DLLs down to the minimum supported version.
  -->
  <Target Name="LowerPdnReferenceVersions" AfterTargets="Build" Condition="'$(PdnMinimumVersion)' != 'none'">
    <Exec Command="dotnet run -c Release --project &quot;$(MSBuildThisFileDirectory)../../tools/PdnRefFix/PdnRefFix.csproj&quot; -- &quot;$(TargetPath)&quot; $(PdnMinimumVersion)" />
  </Target>

  <!-- AI subject model (U²-Net, Apache-2.0). Not in git: create it with tools/model/get_model.sh (or .ps1). -->
  <PropertyGroup>
    <UltraKeyModel Condition="'$(UltraKeyModel)' == ''">$(MSBuildThisFileDirectory)../../tools/model/u2net.ukm</UltraKeyModel>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(UltraKeyModel)')">
    <EmbeddedResource Include="$(UltraKeyModel)" LogicalName="UltraKey.u2net.ukm" />
  </ItemGroup>

</Project>
